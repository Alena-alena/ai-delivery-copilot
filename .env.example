OPENAI_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_DB_PASSWORD=
LITELLM_VERSION=
LITELLM_VIRTUAL_KEY=
LINEAR_API_KEY=
AI_INTERNAL_TOKEN=
AI_SERVICE_URL=http://localhost:8000
LITELLM_URL=http://localhost:4000
ENABLE_DEV_ENDPOINTS=false

# Supabase Postgres (phase 2). Transaction pooler (6543) for the app, session pooler (5432) for migrations.
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Supabase Auth (phase 2). URL is public. The publishable key is public too (safe in the browser); never use the service-role key.
SUPABASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Uploaded documents (a local folder in development).
STORAGE_DIR=./storage

# Upload caps per project (defaults shown).
PROJECT_MAX_DOCUMENTS=50
PROJECT_MAX_STORAGE_MB=200
